{
  "name": "nuxt-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint:js": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint": "pnpm lint:js && pnpm lint:prettier",
    "lint:fix": "prettier --write --list-different . && pnpm lint:js --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev --preview-feature",
    "prisma:studio": "prisma studio",
    "prisma:db:push": "prisma db push",
    "prisma:db:pull": "prisma db pull",
    "postinstall": "nuxt prepare && prisma generate",
    "reset": "rimraf node_modules && rimraf .nuxt && rimraf .output && rimraf dist && pnpm install",
    "l-reset": "rm -rf node_modules && rm -rf .nuxt && rm -rf .output && rm -rf dist && pnpm install",
    "prune-branches": "git removed-branches --prune --force"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "3.3.0",
    "@vueuse/core": "15.0.0",
    "argon2": "0.45.2",
    "date-fns": "4.4.0",
    "dayjs": "1.11.23",
    "dotenv": "18.0.9",
    "kysely": "0.29.8",
    "kysely-postgres-js": "5.0.1",
    "marked": "18.1.3",
    "nanoid": "6.0.2",
    "nodemailer": "10.3.1",
    "postgres": "4.1.0",
    "prisma-kysely": "3.2.1",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/eslint-config-typescript": "12.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/typography": "0.5.20",
    "@types/bcrypt": "6.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/sanitize-html": "2.16.2",
    "@typescript-eslint/parser": "8.72.1",
    "dayjs-nuxt": "2.1.11",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.12.0",
    "nuxt": "4.6.4",
    "nuxt-auth-utils": "0.6.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "prisma": "7.10.1",
    "rimraf": "6.1.4",
    "tailwindcss": "4.3.5",
    "tailwindcss-debug-screens": "3.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vue": "latest",
    "zod": "4.6.7"
  }
}