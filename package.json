{
  "name": "nuxt-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint:check": "oxlint && eslint \"**/*.vue\"",
    "lint:fix": "oxlint --fix && eslint \"**/*.vue\" --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "pnpm run lint:fix && pnpm run fmt",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev --preview-feature",
    "prisma:studio": "prisma studio",
    "prisma:db:push": "prisma db push",
    "prisma:db:pull": "prisma db pull",
    "postinstall": "nuxt prepare && prisma generate",
    "reset": "rimraf node_modules && rimraf .nuxt && rimraf .output && rimraf dist && pnpm install",
    "l-reset": "rm -rf node_modules && rm -rf .nuxt && rm -rf .output && rm -rf dist && pnpm install",
    "prune-branches": "git removed-branches --prune --force"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "3.3.0",
    "@vueuse/core": "14.2.1",
    "argon2": "^0.44.0",
    "date-fns": "4.1.0",
    "kysely": "0.28.16",
    "kysely-postgres-js": "3.0.0",
    "marked": "18.0.2",
    "nodemailer": "8.0.5",
    "prisma-kysely": "3.1.0",
    "sanitize-html": "2.17.3"
  },
  "devDependencies": {
    "@faker-js/faker": "10.4.0",
    "@nuxt/devtools": "4.0.0-alpha.4",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/ui": "4.6.1",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@tailwindcss/typography": "0.5.19",
    "@types/bcrypt": "6.0.0",
    "@types/nodemailer": "8.0.0",
    "@types/sanitize-html": "2.16.1",
    "dayjs-nuxt": "2.1.11",
    "eslint": "10.3.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.9.1",
    "nuxt": "4.4.2",
    "nuxt-auth-utils": "0.5.29",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "prisma": "7.8.0",
    "rimraf": "6.1.3",
    "tailwindcss": "4.2.4",
    "tailwindcss-debug-screens": "3.0.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vue": "latest",
    "zod": "4.4.3"
  }
}