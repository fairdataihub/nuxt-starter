DATABASE_URL=postgresql://admin:root@localhost:5432/nuxt_starter_local?sslmode=disable

# Secret used to seal session cookies (nuxt-auth-utils). Required in production.
# Generate one with: openssl rand -base64 32
NUXT_APP_SECRET=

# Runtime config is read from NUXT_* variables when the server starts.
# (Plain MAIL_PASS etc. are NOT read at runtime.)
NUXT_PUBLIC_ENABLE_EMAIL_VERIFICATION=false

NUXT_MAIL_HOST=mail.smtp.com
NUXT_MAIL_PORT=587
NUXT_MAIL_USER=user
NUXT_MAIL_PASS=password
NUXT_MAIL_FROM=sender@mail.com

# Absolute URL of the app, used to build email verification links
NUXT_EMAIL_VERIFICATION_DOMAIN=http://localhost:3000
